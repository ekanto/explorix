{
  "name": "explorix",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/server",
    "apps/web",
    "e2e"
  ],
  "scripts": {
    "setup": "npm run setup -w @explorix/server",
    "dev": "node scripts/dev.mjs",
    "db": "npm run db -w @explorix/server",
    "db:reset": "npm run db:reset -w @explorix/server",
    "build": "npm run build -w @explorix/web && npm run build -w @explorix/server",
    "start": "npm run start -w @explorix/server",
    "typecheck": "npm run typecheck -w @explorix/server && npm run typecheck -w @explorix/web",
    "test": "npm test -w @explorix/server",
    "test:e2e": "npm test -w e2e",
    "test:all": "npm test && npm run test:e2e"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false
  }
}
