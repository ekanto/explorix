# Explorix server configuration. Copy to .env (or run `npm run setup`).
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in links, emails and CORS-free cookie setup)
APP_URL=http://localhost:5173

# PostgreSQL. In development an embedded PostgreSQL is started automatically
# on this port when nothing is listening (set USE_EMBEDDED_PG=false to disable).
DATABASE_URL=postgresql://explorix:explorix@localhost:54329/explorix
USE_EMBEDDED_PG=true

# Login session lifetime and cookie security (COOKIE_SECURE=true behind HTTPS)
SESSION_TTL_HOURS=72
COOKIE_SECURE=false

# 32-byte key (base64) used to encrypt integration secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Attachment storage (local driver). Files are never served directly from disk.
STORAGE_DIR=./.data/uploads
MAX_UPLOAD_MB=15

# Optional AI assistance. AI_PROVIDER=none disables it; core workflows never need it.
# AI_PROVIDER=openai works with any OpenAI-compatible Chat Completions API
# (OpenAI, Azure OpenAI-compatible gateways, Ollama, LM Studio, ...).
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional email notifications (e.g. smtp://user:pass@smtp.example.com:587)
SMTP_URL=
EMAIL_FROM=Explorix <no-reply@explorix.local>

LOG_LEVEL=info

# First-run bootstrap (production without demo data). When the database has no
# organization yet, the server creates it and its owner at startup. Remove the
# password afterwards; it is ignored once an organization exists.
# BOOTSTRAP_ADMIN_EMAIL=owner@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ORG_NAME=My Organization
