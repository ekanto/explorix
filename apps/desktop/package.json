{
  "name": "@explorix/desktop",
  "productName": "Explorix",
  "private": true,
  "version": "2.0.0",
  "description": "Explorix Desktop: exploratory testing and QA management with evidence-rich reporting",
  "author": "Explorix",
  "license": "UNLICENSED",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs --stage && electron-builder --win --publish never",
    "dist:dir": "node scripts/build.mjs --stage && electron-builder --win dir --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs && playwright test -c e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/yauzl": "^3.4.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "yauzl": "^3.4.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "@types/pg": "^8.15.6",
    "zod": "^3.25.76",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "@types/node": "^26.6.5"
  },
  "build": {
    "appId": "com.explorix.desktop",
    "productName": "Explorix",
    "copyright": "Copyright © 2026 Explorix",
    "executableName": "Explorix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "static/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/resources/server", "to": "server", "filter": ["**/*", "!**/*.map", "!node_modules/**"] },
      { "from": "build/resources/web", "to": "web" },
      { "from": "build/resources/pg", "to": "pg" }
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "electronLanguages": ["en-US"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Explorix",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Explorix ${version}",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
